# Один контейнер: API и (если собран) статика фронтенда.
# Соответствует НФТ из ТЗ — «сервис это один контейнер 2–4 vCPU / 2–4 ГБ RAM».

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/data \
    STATIC_DIR=/app/static

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

# Каталог со статикой фронтенда. Пока фронта нет — остаётся пустым,
# сервис отдаёт только API. Когда фронт появится, положите сюда сборку.
RUN mkdir -p /app/static /data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health').status==200 else 1)"

# ОДИН воркер — это осознанно, не экономия.
#
# Каждый воркер uvicorn это отдельный процесс со своей копией прогноза
# в памяти, своим кешем ответов и своим индексом событий сети. При двух
# воркерах: POST /api/reload перечитает файл только в том процессе, куда
# попал запрос, а добавленное через админку закрытие маршрута увидит
# только один воркер из двух — то есть на демо «добавили закрытие, ничего
# не изменилось» через раз. То же с кешем: половина запросов мимо.
#
# Одного воркера хватает с запасом: прогноз читается из памяти, тяжёлых
# операций на запросе нет. Горизонтальное масштабирование делается
# репликами за балансировщиком на одном и том же immutable прогнозе —
# именно так это и описано в архитектуре.
#
# Если будете поднимать воркеров больше одного, состояние (события сети,
# актуальный релиз) обязано уехать из памяти процесса в общее хранилище.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--log-level", "info"]
