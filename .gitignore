__pycache__/
*.pyc
# Сырые train.csv и test.csv — около 10 ГБ. Всё, что нужно сервису,
# лежит в service/data/ и коммитится: после git clone сервис стартует с данными.
initial_data/
# События сети пишет сам сервис во время работы. Не коммитить: закрытие,
# добавленное на демо, у жюри обнулило бы маршрут.
service/data/network_events.json
service/data/network_events.json.tmp
# Состояние приёма валидаций (агрегаты и batch_id) — тоже состояние демо.
service/data/validations_state.json
service/data/validations_state.json.tmp
# Локальный запуск без Docker: RUNTIME_DIR по умолчанию = data/
service/data/reload.marker
service/data/*.lock
service/data/*.tmp
service/static/
report.txt
.venv/
node_modules/
